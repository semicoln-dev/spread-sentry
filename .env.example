# HACKATHON RULE: use a BRAND-NEW Alpaca paper account created for the
# hackathon, starting balance set to $100,000. Do NOT reuse the orb-trader
# accounts — reused accounts are ineligible for judging, and a fresh account
# also avoids any websocket/position conflicts with the live experiment.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Claude — the AI risk officer. Without a key the deterministic fallback
# grader runs (approves at half size when all gates pass), so the loop
# still works end to end.
ANTHROPIC_API_KEY=

# Optional Telegram alerts (same setup as orb-trader; leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
